# Server Configuration
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# AI Provider Configuration
OPENAI_API_KEY=sk-your-openai-key
GEMINI_API_KEY=your-gemini-api-key
DEFAULT_AI_PROVIDER=openai

# Email Configuration (Resend/SendGrid/Postmark)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=noreply@reviewai.com
EMAIL_FROM_NAME=ReviewAI

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Feature Flags
FEATURE_AI_REVIEW_GENERATION=true
FEATURE_STRIPE_BILLING=true
FEATURE_WEBHOOKS=true
FEATURE_TEAM_MANAGEMENT=true