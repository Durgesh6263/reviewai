    "@sentry/node": "^8.0.0",
    "@supabase/supabase-js": "^2.43.0",
    "axios": "^1.7.0",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "date-fns": "^3.6.0",
    "express": "^4.19.0",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "stripe": "^14.22.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.0"
